Code-
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int m, n;
    if (scanf("%d %d", &m, &n) != 2) {
        return 0; // invalid input
    }

    // Allocate memory for matrices A, B, and result C
    int **A = (int**)malloc(m * sizeof(int*));
    int **B = (int**)malloc(m * sizeof(int*));
    int **C = (int**)malloc(m * sizeof(int*));
    if (!A || !B || !C) return 0; // allocation failed

    for (int i = 0; i < m; i++) {
        A[i] = (int*)malloc(n * sizeof(int));
        B[i] = (int*)malloc(n * sizeof(int));
        C[i] = (int*)malloc(n * sizeof(int));
        if (!A[i] || !B[i] || !C[i]) return 0; // allocation failed
    }

    // Read first matrix A
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    // Read second matrix B
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &B[i][j]);
        }
    }

    // Compute C = A + B
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            C[i][j] = A[i][j] + B[i][j];
        }
    }

    // Output the result matrix C
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            if (j) printf(" ");
            printf("%d", C[i][j]);
        }
        printf("\n");
    }

    // Free allocated memory
    for (int i = 0; i < m; i++) {
        free(A[i]);
        free(B[i]);
        free(C[i]);
    }
    free(A);
    free(B);
