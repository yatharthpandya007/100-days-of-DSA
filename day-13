#include <stdio.h>

int main() {
    int r, c;
    
    // Read the number of rows and columns
    if (scanf("%d %d", &r, &c) != 2) {
        return 0; // Exit if input fails
    }

    // Declare a Variable Length Array (VLA) for the matrix
    int matrix[r][c];

    // Read the matrix elements
    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Define the initial boundaries
    int top = 0;
    int bottom = r - 1;
    int left = 0;
    int right = c - 1;

    // Loop until boundaries cross
    while (top <= bottom && left <= right) {
        
        // 1. Traverse from Left to Right along the Top row
        for (int j = left; j <= right; j++) {
            printf("%d ", matrix[top][j]);
        }
        top++; // Shrink top boundary
        
        // 2. Traverse from Top to Bottom along the Right column
        for (int i = top; i <= bottom; i++) {
            printf("%d ", matrix[i][right]);
        }
        right--; // Shrink right boundary
        
        // 3. Traverse from Right to Left along the Bottom row 
        // Ensure we haven't already processed this row
        if (top <= bottom) {
            for (int j = right; j >= left; j--) {
                printf("%d ", matrix[bottom][j]);
            }
            bottom--; // Shrink bottom boundary
        }
        
        // 4. Traverse from Bottom to Top along the Left column
        // Ensure we haven't already processed this column
        if (left <= right) {
            for (int i = bottom; i >= top; i--) {
                printf("%d ", matrix[i][left]);
            }
            left++; // Shrink left boundary
        }
    }
    
    printf("\n");
    return 0;
}
