#include <stdio.h>

int main() {
    int n;

    // Read the dimension of the square matrix
    if (scanf("%d", &n) != 1) {
        return 0; // Exit if input fails
    }

    int matrix[n][n];
    int isIdentity = 1; // Flag to assume it is an identity matrix initially

    // Read the matrix elements and validate conditions
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);

            // If it's a diagonal element, it must be 1
            if (i == j && matrix[i][j] != 1) {
                isIdentity = 0;
            }
            // If it's a non-diagonal element, it must be 0
            else if (i != j && matrix[i][j] != 0) {
                isIdentity = 0;
            }
        }
    }

    // Print the final result
    if (isIdentity == 1) {
        printf("Identity Matrix\n");
    } else {
        printf("Not an Identity Matrix\n");
    }

    return 0;
}
