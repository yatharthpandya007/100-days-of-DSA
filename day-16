#include <stdio.h>

int main() {
    int n;
    
    // Read the size of the array
    if (scanf("%d", &n) != 1) {
        return 1;
    }

    int arr[n];
    int visited[n]; // Array to keep track of counted elements

    // Read the array elements and initialize the visited array to 0
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        visited[i] = 0;
    }

    // Loop through the array to count frequencies
    for (int i = 0; i < n; i++) {
        // Skip if this element has already been counted
        if (visited[i] == 1) {
            continue;
        }
        
        int count = 1; // Element appears at least once
        
        // Check the rest of the array for duplicates
        for (int j = i + 1; j < n; j++) {
            if (arr[i] == arr[j]) {
                count++;
                visited[j] = 1; // Mark as visited
            }
        }
        
        // Print the element and its frequency
        printf("%d:%d ", arr[i], count);
    }
    
    printf("\n");

    return 0;
}
