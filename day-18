#include <stdio.h>

// Helper function to reverse a portion of the array
void reverse(int arr[], int start, int end) {
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
}

int main() {
    int n, k;
    
    // Read the size of the array
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1; // Exit if input fails or array size is invalid
    }

    int arr[n];

    // Read the array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Read the number of rotations
    if (scanf("%d", &k) != 1) {
        return 1;
    }

    // Normalize k in case it is larger than the array size
    k = k % n;

    // Perform the right rotation using the reversal algorithm
    if (k > 0) {
        // Step 1: Reverse the entire array
        reverse(arr, 0, n - 1);
        
        // Step 2: Reverse the first k elements
        reverse(arr, 0, k - 1);
        
        // Step 3: Reverse the remaining n-k elements
        reverse(arr, k, n - 1);
    }

    // Print the rotated array
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
