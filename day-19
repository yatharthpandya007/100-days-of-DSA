#include <stdio.h>
#include <stdlib.h>

// Comparison function required by the qsort() function
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int main() {
    int n;
    
    // Read the size of the array
    if (scanf("%d", &n) != 1 || n < 2) {
        return 1; // Exit if input fails or there are fewer than 2 elements
    }

    int arr[n];

    // Read the array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Step 1: Sort the array in ascending order
    qsort(arr, n, sizeof(int), compare);

    int left = 0;           // Pointer starting from the left (smallest values)
    int right = n - 1;      // Pointer starting from the right (largest values)
    
    // Initialize the minimum sum with the extreme ends
    int min_sum = arr[left] + arr[right];
    int pair1 = arr[left];
    int pair2 = arr[right];

    // Step 2: Use the two-pointer approach to find the sum closest to zero
    while (left < right) {
        int current_sum = arr[left] + arr[right];

        // If the absolute value of the current sum is smaller, update our minimums
        if (abs(current_sum) < abs(min_sum)) {
            min_sum = current_sum;
            pair1 = arr[left];
            pair2 = arr[right];
        }

        // If the sum is exactly zero, we can't get any closer, so we stop searching
        if (current_sum == 0) {
            break;
        }

        // Move the pointers to steer the sum closer to zero
        if (current_sum < 0) {
            left++;  // The sum is too negative; increase it by moving right
        } else {
            right--; // The sum is too positive; decrease it by moving left
        }
    }

    // Print the pair that yielded the sum closest to zero
    printf("%d %d\n", pair1, pair2);

    return 0;
}
